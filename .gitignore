build/*.npy
build/*.pkl
build/*.json
build/*.png
build/_selftest/
model/*_summary.json
model/*_progress.json
model/*_render_probe.json
renders/rhino/probe_render.png

# confidential inputs must never be committed (the build scripts read them from MOCKUP_SOURCES)
/sources
/research
/photos

# editor / OS
.vscode/
.idea/
.claude/
Thumbs.db
desktop.ini
.DS_Store
