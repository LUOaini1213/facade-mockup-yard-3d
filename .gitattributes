# normalise line endings of text files; the Windows launcher keeps CRLF
* text=auto
*.bat text eol=crlf
# binary data: no line-ending conversion, no text diff
*.glb binary
*.3dm binary
*.png binary
*.jpg binary
*.jpeg binary
*.hdr binary
*.exr binary
model/vmu_site_future_native.3dm filter=lfs diff=lfs merge=lfs -text

# Portable delivery fingerprints and deterministic public text assets
*.txt text eol=lf
*.html text eol=lf
*.ids text eol=lf
*.py text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.js text eol=lf
